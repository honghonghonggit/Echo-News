# ──────────────────────────────────────────────
# Echo-News 환경변수 설정 파일
# ──────────────────────────────────────────────
# 이 파일을 복사하여 .env 파일을 생성한 뒤
# 실제 API 키를 입력하세요.
# cp .env.example .env

# Django Secret Key
DJANGO_SECRET_KEY=your-django-secret-key-here

# 네이버 뉴스 검색 API 키 (https://developers.naver.com 에서 발급)
NAVER_CLIENT_ID=your-naver-client-id-here
NAVER_CLIENT_SECRET=your-naver-client-secret-here

# ──────────────────────────────────────────────
# 아래 API는 별도의 API 키가 필요하지 않습니다.
# ──────────────────────────────────────────────
# - Open-Meteo API       : 날씨 정보 (기온, 풍속, 주간 예보)
# - Open-Meteo Air Quality API : 대기질 정보 (미세먼지 PM10)
# - Yahoo Finance (비공식 API)  : 환율 · 주요 지수 티커 데이터
